# 东南大学讲座抢票脚本配置模板
#
# 用法：
#   cp config.yaml.example config.yaml
#   然后填上自己的账号密码，保存即可（config.yaml 已在 .gitignore 里，不会被提交）
#
# 也可以不建 config.yaml，直接用环境变量覆盖下面四项敏感配置：
#   SEU_CARD_NUMBER / SEU_PASSWORD / QQ_EMAIL_ADDRESS / QQ_EMAIL_AUTH_CODE
#
# 未写在这里的项会使用 main.py 里的默认值；只写你想改的项也可以。

# ==================== 登录凭证 ====================
card_number: ""        # 一卡通号
password: ""           # 登录密码

# ==================== 通知邮箱（QQ） ====================
# 抢票结果 / 登录成功 / 疑似成功 会发到自己的 QQ 邮箱
qq_email: ""           # 收通知的 QQ 邮箱，例如 123456789@qq.com
qq_auth_code: ""       # QQ 邮箱 SMTP 授权码（不是 QQ 登录密码）

# ==================== 讲座筛选条件 ====================
# 指定讲座名称（精确/部分匹配），留空表示不按名称筛选
preferred_lectures: []

# 想抢的讲座类别白名单
required_categories:
  - "人文与科学素养系列讲座_心理健康"
  - "人文与科学素养系列讲座_法律"
  - "人文与科学素养系列讲座-艺术类"
  - "人文与科学素养系列讲座_其他"
  - '“SEU咖啡间"系列沙龙活动'

# 优先校区，排在前面的优先抢
preferred_campus: []   # 校区白名单，留空 = 不限校区（优先级由下面 priority 决定）

enable_offline: true   # 是否抢线下讲座
enable_online: true    # 是否抢线上讲座（标题里含“线上”的）

# ==================== 抢票优先级 ====================
# 越靠前越先抢；不在这张表里的一律排最后，但仍然会抢。
#   campus: 校区名（也匹配地点字段里含这几个字的讲座）
#   mode:   online = 标题含“线上”；offline = 线下
priority:
  - campus: "四牌楼校区"
    mode: "online"
  - campus: "九龙湖校区"
    mode: "offline"

# ==================== 回流票监控 ====================
# 抢票窗口结束后，继续进出详情页检测是否有别人退掉的名额
watch_backflow: true
backflow_dense_seconds: 60     # 密集监控时长(秒)
backflow_interval: 3           # 密集阶段的间隔(秒)
backflow_slow_interval: 60     # 密集阶段之后的间隔(秒)
backflow_total_seconds: 60     # 回流监控总时长上限(秒)

# ==================== 时间参数 ====================
timeout_settings:
  page_load: 0.5        # 页面加载基础等待时间
  element_wait: 3       # 元素查找最大等待时间
  # 浏览器未认证 / 掉认证时调大到 60，完成短信验证后改回
  login_redirect: 120
  scan_interval: 0.05   # 扫描间隔时间
  retry_delay: 0.05     # 重试延迟时间
  action_confirm: 0.2   # 操作确认等待时间
